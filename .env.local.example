# Copy this file to .env.local for local development, and add the same
# values in Vercel → Project → Settings → Environment Variables for the
# live site.

# --- Supabase (already set up) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase → Settings → API → "service_role" key. Keep this secret — never
# put it in NEXT_PUBLIC_*, it must only ever be read on the server.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL ---
# Used to build Stripe/PayPal redirect links. Leave blank for local dev
# (it falls back to http://localhost:3000 automatically); set it to
# https://airstay.uk once the domain is live.
NEXT_PUBLIC_SITE_URL=

# --- Stripe ---
# Stripe Dashboard → Developers → API keys → "Secret key"
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → your endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=

# --- PayPal ---
# developer.paypal.com → Apps & Credentials → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" while testing, "live" once ready for real payments
PAYPAL_ENV=sandbox

# --- Cron (optional but recommended) ---
# Any random string — protects /api/cron/expire-bookings from being called
# by anyone other than Vercel's own scheduler.
CRON_SECRET=
